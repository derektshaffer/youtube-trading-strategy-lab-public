{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trading Intelligence Tauri Spike",
  "version": "0.1.0",
  "identifier": "com.derektshaffer.trading-intelligence-spike",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Trading Intelligence",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:8765; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/trading-intelligence-service"]
  }
}
