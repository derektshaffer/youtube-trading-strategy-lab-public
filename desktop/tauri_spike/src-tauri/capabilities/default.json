{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for the Trading Intelligence framework spike",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/trading-intelligence-service",
          "sidecar": true,
          "args": [
            "--token",
            {
              "validator": "^[A-Za-z0-9_-]{32,128}$"
            }
          ]
        }
      ]
    }
  ]
}
