{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for the Trading Intelligence framework spike",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:allow-kill",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/trading-intelligence-service",
          "sidecar": true,
          "args": [
            "--host",
            "127.0.0.1",
            "--port",
            {
              "validator": "^[1-9][0-9]{3,4}$"
            }
          ]
        }
      ]
    }
  ]
}
