{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:systematic-trader:event:v1",
  "title": "Systematic Trader capture event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "run_id",
    "connection_id",
    "provider",
    "feed",
    "adapter_version",
    "received_ns",
    "received_monotonic_ns",
    "normalized_ns",
    "raw_id",
    "raw_index",
    "source_time_ns",
    "source_sequence",
    "source_event_id",
    "symbol",
    "instrument_id",
    "identity_event_id",
    "duplicate_of",
    "schema_version",
    "event_type",
    "origin",
    "execution_authority",
    "payload",
    "quality_flags",
    "content_hash"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "connection_id": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "feed": {
      "type": "string",
      "minLength": 1
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1
    },
    "received_ns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "received_monotonic_ns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "normalized_ns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "raw_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "raw_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "source_time_ns": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        {
          "type": "null"
        }
      ]
    },
    "source_sequence": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        {
          "type": "null"
        }
      ]
    },
    "source_event_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "symbol": {
      "type": [
        "string",
        "null"
      ]
    },
    "instrument_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "identity_event_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "duplicate_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "const": 1
    },
    "event_type": {
      "enum": [
        "market.bar",
        "market.bar_revision",
        "market.luld",
        "market.quote",
        "market.status",
        "market.trade",
        "market.trade_cancel",
        "market.trade_correction",
        "provider.control",
        "recorder.gap",
        "recorder.heartbeat",
        "recorder.lifecycle",
        "recorder.reject",
        "reference.calendar",
        "reference.corporate_action",
        "reference.instrument"
      ]
    },
    "origin": {
      "enum": [
        "live",
        "fixture",
        "import"
      ]
    },
    "execution_authority": {
      "const": "none"
    },
    "payload": {
      "type": "object"
    },
    "quality_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "pattern": "^market\\."
          }
        }
      },
      "then": {
        "properties": {
          "symbol": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9.\\-]{0,15}$"
          },
          "source_time_ns": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "market.trade"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "price",
              "size_shares",
              "exchange",
              "conditions",
              "tape"
            ],
            "properties": {
              "price": {
                "type": "string",
                "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
              },
              "size_shares": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "exchange": {
                "type": "string",
                "minLength": 1
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "tape": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "market.quote"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "bid",
              "ask",
              "bid_size",
              "ask_size",
              "size_unit",
              "round_lot_size",
              "bid_exchange",
              "ask_exchange",
              "conditions",
              "tape"
            ],
            "properties": {
              "bid": {
                "type": "string",
                "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
              },
              "ask": {
                "type": "string",
                "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
              },
              "bid_size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "ask_size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "bid_exchange": {
                "type": "string",
                "minLength": 1
              },
              "ask_exchange": {
                "type": "string",
                "minLength": 1
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "tape": {
                "type": "string",
                "minLength": 1
              },
              "size_unit": {
                "const": "provider_round_lots"
              },
              "round_lot_size": {
                "const": null
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "market.bar"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "open",
              "high",
              "low",
              "close",
              "volume_shares",
              "trade_count",
              "vwap",
              "interval_ns",
              "revision",
              "revision_key",
              "tape"
            ],
            "properties": {
              "open": {
                "type": "string",
                "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
              },
              "high": {
                "type": "string",
                "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
              },
              "low": {
                "type": "string",
                "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
              },
              "close": {
                "type": "string",
                "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
              },
              "vwap": {
                "type": "string",
                "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
              },
              "volume_shares": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "trade_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "interval_ns": {
                "const": 60000000000
              },
              "revision": {
                "const": false
              },
              "revision_key": {
                "type": "string",
                "minLength": 1
              },
              "tape": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "market.bar_revision"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "open",
              "high",
              "low",
              "close",
              "volume_shares",
              "trade_count",
              "vwap",
              "interval_ns",
              "revision",
              "revision_key",
              "tape"
            ],
            "properties": {
              "open": {
                "type": "string",
                "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
              },
              "high": {
                "type": "string",
                "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
              },
              "low": {
                "type": "string",
                "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
              },
              "close": {
                "type": "string",
                "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
              },
              "vwap": {
                "type": "string",
                "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
              },
              "volume_shares": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "trade_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "interval_ns": {
                "const": 60000000000
              },
              "revision": {
                "const": true
              },
              "revision_key": {
                "type": "string",
                "minLength": 1
              },
              "tape": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "market.trade_correction"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "original_trade_id",
              "corrected_trade_id",
              "original_price",
              "corrected_price",
              "original_size_shares",
              "corrected_size_shares",
              "original_conditions",
              "corrected_conditions",
              "exchange",
              "tape"
            ],
            "properties": {
              "original_trade_id": {
                "type": "string",
                "minLength": 1
              },
              "corrected_trade_id": {
                "type": "string",
                "minLength": 1
              },
              "exchange": {
                "type": "string",
                "minLength": 1
              },
              "tape": {
                "type": "string",
                "minLength": 1
              },
              "original_price": {
                "type": "string",
                "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
              },
              "corrected_price": {
                "type": "string",
                "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
              },
              "original_size_shares": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "corrected_size_shares": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "original_conditions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "corrected_conditions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "market.trade_cancel"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "original_trade_id",
              "action",
              "price",
              "size_shares",
              "exchange",
              "tape"
            ],
            "properties": {
              "price": {
                "type": "string",
                "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
              },
              "size_shares": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "exchange": {
                "type": "string",
                "minLength": 1
              },
              "tape": {
                "type": "string",
                "minLength": 1
              },
              "original_trade_id": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "enum": [
                  "C",
                  "E"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "market.status"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "status_code",
              "reason_code",
              "tape"
            ],
            "properties": {
              "status_code": {
                "type": "string",
                "minLength": 1
              },
              "reason_code": {
                "type": "string",
                "minLength": 1
              },
              "tape": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "market.luld"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "limit_up",
              "limit_down",
              "indicator",
              "tape"
            ],
            "properties": {
              "limit_up": {
                "type": "string",
                "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
              },
              "limit_down": {
                "type": "string",
                "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
              },
              "indicator": {
                "type": "string",
                "minLength": 1
              },
              "tape": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "reference.instrument"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "symbol",
              "instrument_id",
              "effective_from_ns",
              "effective_to_ns",
              "source",
              "source_sha256"
            ],
            "properties": {
              "symbol": {
                "type": "string",
                "minLength": 1
              },
              "instrument_id": {
                "type": "string",
                "minLength": 1
              },
              "effective_from_ns": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "effective_to_ns": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "source_sha256": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "reference.calendar"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "exchange",
              "open",
              "close",
              "source",
              "source_sha256"
            ],
            "properties": {
              "exchange": {
                "type": "string",
                "minLength": 1
              },
              "open": {
                "type": "string",
                "minLength": 1
              },
              "close": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "source_sha256": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "reference.corporate_action"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "instrument_id",
              "action_id",
              "action_type",
              "effective_at",
              "source",
              "source_sha256"
            ],
            "properties": {
              "instrument_id": {
                "type": "string",
                "minLength": 1
              },
              "action_id": {
                "type": "string",
                "minLength": 1
              },
              "action_type": {
                "type": "string",
                "minLength": 1
              },
              "effective_at": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "source_sha256": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "recorder.reject"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "recorder.gap"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "reason",
              "unresolved"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "unresolved": {
                "const": true
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "recorder.lifecycle"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "recorder.heartbeat"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "provider.control"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        }
      }
    }
  ]
}
